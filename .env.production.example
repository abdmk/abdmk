# Production environment variables for Netlify deployment.
#
# Copy this to .env.production and fill in real values before deployment.
# Also set these variables in Netlify Site Settings → Environment.

# Password for /admin in production. Set to a strong password.
# Without this, every login attempt is rejected.
ADMIN_PASSWORD=your_strong_password_here

# Secret key for signing admin session cookies. Generate with:
#   openssl rand -base64 32
# Falls back to ADMIN_PASSWORD if unset, but should be different and longer.
ADMIN_SECRET=your_generated_secret_here

# Optional: Email configuration for contact form
# RESEND_API_KEY=re_xxxxx (from resend.com)
# SENDGRID_API_KEY=SG.xxxxx (from sendgrid.com)
